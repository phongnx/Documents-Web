{
  "rules": {
    "admin": {
      "allowed": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && root.child('admin/allowed').child($uid).val() === true",
        ".write": "auth != null && auth.uid === $uid && root.child('admin/allowed').child($uid).val() === true"
      }
    },
    "shared": {
      "kpi": {
        "$token": {
          ".read": true,
          ".write": "auth != null && root.child('admin/allowed').child(auth.uid).val() === true && (data.exists() ? data.child('meta/ownerId').val() === auth.uid : newData.child('meta/ownerId').val() === auth.uid)",
          "meta": {
            ".validate": "newData.child('ownerId').isString() && (!data.child('ownerId').exists() || data.child('ownerId').val() === newData.child('ownerId').val())"
          },
          "entries": {
            ".indexOn": ["date"],
            "$entryId": {
              ".write": "data.parent().parent().child('meta').exists() && !data.parent().parent().child('scores').child($entryId).exists() && data.parent().parent().child('meta/locked').val() !== true",
              ".validate": "newData.hasChildren(['id','date','createdAt','updatedAt']) && newData.child('date').val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && (!newData.child('start').exists() || newData.child('start').val().matches(/^[0-9]{2}:[0-9]{2}$/)) && (!newData.child('end').exists() || newData.child('end').val().matches(/^[0-9]{2}:[0-9]{2}$/)) && (!newData.child('task').exists() || (newData.child('task').isString() && newData.child('task').val().length <= 2000)) && (!newData.child('note').exists() || (newData.child('note').isString() && newData.child('note').val().length <= 2000)) && (!newData.child('selfDelta').exists() || newData.child('selfDelta').isNumber())"
            }
          },
          "scores": {
            "$entryId": {
              ".validate": "newData.hasChildren(['delta','scoredAt']) && newData.child('delta').isNumber() && newData.parent().parent().child('entries').child($entryId).exists()"
            }
          },
          "weekPlans": {
            "$weekStart": {
              ".write": "data.parent().parent().child('meta').exists() && data.parent().parent().child('meta/locked').val() !== true",
              ".validate": "newData.hasChildren(['text','updatedAt']) && newData.child('text').isString() && newData.child('text').val().length <= 4000"
            }
          },
          "leaves": {
            "$leaveId": {
              ".validate": "newData.hasChildren(['id','startDate','days','createdAt']) && newData.child('startDate').val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.child('days').isNumber() && newData.child('days').val() >= 0.5 && newData.child('days').val() <= 3"
            }
          }
        }
      },
      "est": {
        "$estId": {
          ".read": true,
          ".write": "auth != null && root.child('admin/allowed').child(auth.uid).val() === true && (data.exists() ? data.child('meta/ownerId').val() === auth.uid : newData.child('meta/ownerId').val() === auth.uid)",
          "meta": {
            ".validate": "newData.child('ownerId').isString() && (!data.child('ownerId').exists() || data.child('ownerId').val() === newData.child('ownerId').val())"
          },
          "groups": {
            ".write": "data.parent().child('meta').exists() && data.parent().child('meta/locked').val() !== true && data.parent().child('meta/state').val() === 'draft'",
            "$gid": {
              ".validate": "newData.hasChildren(['id','title','order'])",
              "tasks": {
                "$tid": {
                  ".validate": "newData.hasChildren(['id','title','order','status']) && newData.child('title').val().length <= 500 && (!newData.child('estHours').exists() || newData.child('estHours').isNumber()) && (!newData.child('note').exists() || (newData.child('note').isString() && newData.child('note').val().length <= 2000))",
                  "status": {
                    ".write": "data.parent().parent().parent().parent().parent().child('meta').exists() && data.parent().parent().parent().parent().parent().child('meta/locked').val() !== true",
                    ".validate": "newData.val() === 'todo' || newData.val() === 'doing' || newData.val() === 'done'"
                  },
                  "note": {
                    ".write": "data.parent().parent().parent().parent().parent().child('meta').exists() && data.parent().parent().parent().parent().parent().child('meta/locked').val() !== true"
                  }
                }
              }
            }
          },
          "logs": {
            "$taskId": {
              "$entryId": {
                ".write": "data.parent().parent().parent().child('meta').exists() && data.parent().parent().parent().child('meta/locked').val() !== true",
                ".validate": "newData.isNumber() && newData.val() >= 0"
              }
            }
          }
        }
      },
      "kpisum": {
        "$sumId": {
          ".read": true,
          ".write": "auth != null && root.child('admin/allowed').child(auth.uid).val() === true && (data.exists() ? data.child('meta/ownerId').val() === auth.uid : newData.child('meta/ownerId').val() === auth.uid)",
          "meta": {
            ".validate": "newData.child('ownerId').isString() && (!data.child('ownerId').exists() || data.child('ownerId').val() === newData.child('ownerId').val())"
          }
        }
      },
      "$type": {
        "$id": {
          ".read": true,
          ".write": "auth != null && root.child('admin/allowed').child(auth.uid).val() === true && (!data.exists() ? newData.child('ownerId').val() === auth.uid : data.child('ownerId').val() === auth.uid)"
        }
      }
    }
  }
}
