{
  "rules": {
    "admin": {
      "allowed": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && root.child('admin/allowed').child($uid).val() === true",
        ".write": "auth != null && auth.uid === $uid && root.child('admin/allowed').child($uid).val() === true"
      }
    },
    "shared": {
      "kpi": {
        "$token": {
          ".read": true,
          ".write": "auth != null && root.child('admin/allowed').child(auth.uid).val() === true && (data.exists() ? data.child('meta/ownerId').val() === auth.uid : newData.child('meta/ownerId').val() === auth.uid)",
          "meta": {
            ".validate": "newData.child('ownerId').isString() && (!data.child('ownerId').exists() || data.child('ownerId').val() === newData.child('ownerId').val())"
          },
          "entries": {
            ".indexOn": ["date"],
            "$entryId": {
              ".write": "data.parent().parent().child('meta').exists() && !data.parent().parent().child('scores').child($entryId).exists() && data.parent().parent().child('meta/locked').val() !== true",
              ".validate": "newData.child('id').val() === $entryId && newData.hasChildren(['id','date','createdAt','updatedAt'])",
              "id": { ".validate": "newData.val() === $entryId" },
              "date": { ".validate": "newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
              "start": { ".validate": "newData.val().matches(/^[0-9]{2}:[0-9]{2}$/)" },
              "end": { ".validate": "newData.val().matches(/^[0-9]{2}:[0-9]{2}$/)" },
              "category": { ".validate": "newData.isString() && newData.val().length <= 200" },
              "project": { ".validate": "newData.isString() && newData.val().length <= 200" },
              "feature": { ".validate": "newData.isString() && newData.val().length <= 500" },
              "task": { ".validate": "newData.isString() && newData.val().length <= 2000" },
              "note": { ".validate": "newData.isString() && newData.val().length <= 2000" },
              "selfDelta": { ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 100" },
              "createdAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "updatedAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "estRef": {
                ".validate": "newData.hasChildren(['estId','groupId','taskId'])",
                "estId": { ".validate": "newData.isString() && newData.val().length <= 60" },
                "groupId": { ".validate": "newData.isString() && newData.val().length <= 60" },
                "taskId": { ".validate": "newData.isString() && newData.val().length <= 60" },
                "title": { ".validate": "newData.isString() && newData.val().length <= 500" },
                "$other": { ".validate": "$other.matches(/^(estId|groupId|taskId|title)$/)" }
              },
              "rel": {
                ".validate": "newData.hasChild('label')",
                "label": { ".validate": "newData.isString() && newData.val().length <= 200" },
                "date": { ".validate": "newData.isString() && newData.val().length <= 40" },
                "$other": { ".validate": "$other.matches(/^(label|date)$/)" }
              },
              "$other": { ".validate": "$other.matches(/^(id|date|start|end|category|project|feature|task|note|selfDelta|estRef|rel|createdAt|updatedAt)$/)" }
            }
          },
          "scores": {
            "$entryId": {
              ".validate": "newData.hasChildren(['delta','scoredAt']) && newData.child('delta').isNumber() && newData.parent().parent().child('entries').child($entryId).exists()"
            }
          },
          "weekPlans": {
            "$weekStart": {
              ".write": "data.parent().parent().child('meta').exists() && data.parent().parent().child('meta/locked').val() !== true",
              ".validate": "$weekStart.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.hasChildren(['text','updatedAt'])",
              "text": { ".validate": "newData.isString() && newData.val().length <= 4000" },
              "updatedAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "$other": { ".validate": "$other.matches(/^(text|updatedAt)$/)" }
            }
          },
          "leaves": {
            "$leaveId": {
              ".validate": "newData.hasChildren(['id','startDate','days','createdAt']) && newData.child('startDate').val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.child('days').isNumber() && newData.child('days').val() >= 0.5 && newData.child('days').val() <= 3"
            }
          }
        }
      },
      "est": {
        "$estId": {
          ".read": true,
          ".write": "auth != null && root.child('admin/allowed').child(auth.uid).val() === true && (data.exists() ? data.child('meta/ownerId').val() === auth.uid : newData.child('meta/ownerId').val() === auth.uid)",
          "meta": {
            ".validate": "newData.child('ownerId').isString() && (!data.child('ownerId').exists() || data.child('ownerId').val() === newData.child('ownerId').val())"
          },
          "groups": {
            ".write": "data.parent().child('meta').exists() && data.parent().child('meta/locked').val() !== true && data.parent().child('meta/state').val() === 'draft' && newData.exists()",
            "$gid": {
              ".write": "data.parent().parent().child('meta').exists() && data.parent().parent().child('meta/locked').val() !== true && data.parent().parent().child('meta/state').val() === 'draft'",
              ".validate": "newData.child('id').val() === $gid && newData.hasChildren(['id','title','order'])",
              "id": { ".validate": "newData.val() === $gid" },
              "title": { ".validate": "newData.isString() && newData.val().length <= 500" },
              "desc": { ".validate": "newData.isString() && newData.val().length <= 4000" },
              "order": { ".validate": "newData.isNumber()" },
              "tasks": {
                "$tid": {
                  ".validate": "newData.child('id').val() === $tid && newData.hasChildren(['id','title','order','status'])",
                  "id": { ".validate": "newData.val() === $tid" },
                  "title": { ".validate": "newData.isString() && newData.val().length <= 500" },
                  "assigneeId": { ".validate": "newData.isString() && newData.val().length <= 60" },
                  "assigneeName": { ".validate": "newData.isString() && newData.val().length <= 200" },
                  "estHours": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
                  "order": { ".validate": "newData.isNumber()" },
                  "status": {
                    ".write": "data.parent().parent().parent().parent().parent().child('meta').exists() && data.parent().parent().parent().parent().parent().child('meta/locked').val() !== true",
                    ".validate": "newData.val() === 'todo' || newData.val() === 'doing' || newData.val() === 'done'"
                  },
                  "note": {
                    ".write": "data.parent().parent().parent().parent().parent().child('meta').exists() && data.parent().parent().parent().parent().parent().child('meta/locked').val() !== true",
                    ".validate": "newData.isString() && newData.val().length <= 2000"
                  },
                  "$other": { ".validate": "$other.matches(/^(id|title|assigneeId|assigneeName|estHours|status|note|order)$/)" }
                }
              },
              "$other": { ".validate": "$other.matches(/^(id|title|desc|order|tasks)$/)" }
            }
          },
          "logs": {
            "$taskId": {
              "$entryId": {
                ".write": "data.parent().parent().parent().child('meta').exists() && data.parent().parent().parent().child('meta/locked').val() !== true",
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
              }
            }
          }
        }
      },
      "kpisum": {
        "$sumId": {
          ".read": true,
          ".write": "auth != null && root.child('admin/allowed').child(auth.uid).val() === true && (data.exists() ? data.child('meta/ownerId').val() === auth.uid : newData.child('meta/ownerId').val() === auth.uid)",
          "meta": {
            ".validate": "newData.child('ownerId').isString() && (!data.child('ownerId').exists() || data.child('ownerId').val() === newData.child('ownerId').val())"
          }
        }
      },
      "d": {
        "$id": {
          ".read": true,
          ".write": "auth != null && root.child('admin/allowed').child(auth.uid).val() === true && (!data.exists() ? newData.child('ownerId').val() === auth.uid : data.child('ownerId').val() === auth.uid)"
        }
      },
      "f": {
        "$id": {
          ".read": true,
          ".write": "auth != null && root.child('admin/allowed').child(auth.uid).val() === true && (!data.exists() ? newData.child('ownerId').val() === auth.uid : data.child('ownerId').val() === auth.uid)"
        }
      }
    }
  }
}
